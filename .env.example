# QE ONLY. Run `npm run env` to fill .env.local from the sibling repos' QE values.
APP_ENV=qe
ES_QE_URL=                      # vakilsearch-next/.env ES_QE_URL (prefer a read-only API user)
QE_ES_HOST=                     # must equal the host in ES_QE_URL; the app refuses any other host
UTS_INDEX=vakilsearch-site-users-track
EVENTS_INDEX=vakilsearch_event_tracking
REQUEST_REGISTRY_INDEX=test_payway_request_registry
TRANSACTION_LOGS_INDEX=test_payway_transaction_logs
NATIVE_PG_LOGS_INDEX=test_payway_native_pg_logs
# Required as soon as the app runs anywhere but local dev (HTTP Basic). No key = deployed app refuses to serve.
DASHBOARD_USER=
DASHBOARD_ACCESS_KEY=
